{
  "name": "shuimo-core",
  "version": "0.1.0",
  "private": true,
  "description": "A procedural Chinese landscape painting generation library",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @shuimo/playground dev",
    "build": "pnpm --filter @shuimo/core build",
    "build:all": "pnpm -r --filter \"./packages/**\" build",
    "build:playground": "pnpm run build && pnpm --filter @shuimo/playground build",
    "test": "pnpm --filter @shuimo/core test",
    "lint": "vp check",
    "upgrade": "pnpm dlx taze -r -w major --install"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.0"
}
