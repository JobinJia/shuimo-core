{
  "name": "@jobinjia/shuimo-core",
  "version": "2.0.3",
  "description": "Core library for procedural Chinese landscape painting generation",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./foundation": {
      "types": "./dist/foundation.d.mts",
      "import": "./dist/foundation.mjs"
    },
    "./elements": {
      "types": "./dist/elements.d.mts",
      "import": "./dist/elements.mjs"
    },
    "./drawing": {
      "types": "./dist/drawing.d.mts",
      "import": "./dist/drawing.mjs"
    },
    "./stamp-v2": {
      "types": "./dist/stamp-v2.d.mts",
      "import": "./dist/stamp-v2.mjs"
    },
    "./xuan-paper/worker": {
      "types": "./dist/xuan-paper-worker.d.mts",
      "import": "./dist/xuan-paper-worker.mjs"
    },
    "./xuan-paper/worker-protocol": {
      "types": "./dist/xuan-paper-worker-protocol.d.mts",
      "import": "./dist/xuan-paper-worker-protocol.mjs"
    },
    "./stamp/font-worker": {
      "types": "./dist/stamp-font-worker.d.mts",
      "import": "./dist/stamp-font-worker.mjs"
    },
    "./stamp/font-worker-protocol": {
      "types": "./dist/stamp-font-worker-protocol.d.mts",
      "import": "./dist/stamp-font-worker-protocol.mjs"
    },
    "./wasm/*": "./dist/wasm/*"
  },
  "scripts": {
    "build": "tsc --noEmit && vp pack",
    "build:wasm-data": "node scripts/encode-wasm.mjs",
    "build:copy-wasm": "mkdir -p dist/wasm && cp wasm/shuimo-noise/pkg/shuimo_noise.js wasm/shuimo-noise/pkg/shuimo_noise_bg.wasm wasm/harfbuzz/harfbuzz-subset.wasm dist/wasm/",
    "build:watch": "vp pack --watch",
    "test": "vp test",
    "test:ui": "vp test --ui",
    "bench": "vp test bench",
    "test:coverage": "vp test --coverage",
    "generate:font-metrics": "npx tsx scripts/generate-font-metrics.mts",
    "subset:demo": "tsx scripts/audit-stamp-chars.mts | tsx scripts/subset-font.mts ../../playground/public/fonts/yishanbeizhuanti.ttf @/dev/stdin ../../playground/public/fonts/yishanbeizhuanti.demo.woff2"
  },
  "dependencies": {
    "fontkit": "^2.0.4",
    "harfbuzzjs": "^1.4.0",
    "polygon-clipping": "^0.15.7",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/fontkit": "^2.0.9",
    "@types/node": "^26.1.1",
    "@types/uuid": "^11.0.0",
    "@vitest/ui": "^4.1.10",
    "@webgpu/types": "^0.1.71",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
