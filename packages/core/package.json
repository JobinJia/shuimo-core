{
  "name": "@shuimo/core",
  "type": "module",
  "version": "0.1.0",
  "description": "Core library for procedural Chinese landscape painting generation",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./foundation": {
      "types": "./dist/foundation.d.mts",
      "import": "./dist/foundation.mjs"
    },
    "./elements": {
      "types": "./dist/elements.d.mts",
      "import": "./dist/elements.mjs"
    },
    "./drawing": {
      "types": "./dist/drawing.d.mts",
      "import": "./dist/drawing.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --noEmit && tsdown",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/uuid": "^10.0.0",
    "@vitest/ui": "^4.1.2",
    "@webgpu/types": "^0.1.69",
    "jsdom": "^29.0.1",
    "opentype.js": "^1.3.4",
    "tsdown": "0.17.0-beta.1",
    "typescript": "^6.0.2",
    "vite": "^8.0.3",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.2"
  }
}
